{
    "name": "Elden Hacker",
    "description": "Elden Ring experience for TryHackMe and HackTheBox",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_icon": {
            "16": "assets/icon16.png",
            "24": "assets/icon24.png",
            "32": "assets/icon32.png"
        },
        "default_title": "Elden Hacker",
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "assets/icon16.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    },
    "permissions": [
        "webRequest",
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "https://tryhackme.com/*",
        "https://app.hackthebox.com/*",
        "https://labs.hackthebox.com/*",
        "https://academy.hackthebox.com/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://tryhackme.com/*",
                "https://app.hackthebox.com/*",
                "https://labs.hackthebox.com/*",
                "https://academy.hackthebox.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js",
                "logger.js",
                "utils.js",
                "banners/*",
                "sounds/*",
                "assets/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
